{
  "manifest_version": 3,
  "name": "ik wil werk zoeken",
  "version": "0.1.0",
  "description": "Save a copied job link to your ik wil werk zoeken tracker, and see whether the company is a recognised HSM sponsor first.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "clipboardRead"],
  "host_permissions": [
    "https://api.nogoibay.org/*",
    "http://localhost:7198/*",
    "http://127.0.0.1:7198/*"
  ],
  "action": {
    "default_title": "Add an application",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
